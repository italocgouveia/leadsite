# Neon Postgres (Vercel > Storage > Neon). Use a connection string "pooled".
DATABASE_URL="postgresql://user:senha@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Opcional: só se um dia quiser trocar o OpenStreetMap pelo Google (exige cartão)
GOOGLE_PLACES_API_KEY=""

# Grátis, sem cartão: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Senha única de acesso ao painel (só você usa). Deixe vazio se for entrar só
# pelo Google.
APP_PASSWORD=""

# Assina o cookie de sessão. Gere com: openssl rand -base64 32
# Se ficar vazio, o APP_PASSWORD é usado como segredo.
AUTH_SECRET=""

# Login com Google (opcional). Google Cloud > APIs e Serviços > Credenciais >
# ID do cliente OAuth > Aplicativo da Web. Em "URIs de redirecionamento
# autorizados" cadastre, uma linha para cada ambiente:
#   http://localhost:3000/api/auth/google/callback
#   https://SEU-APP.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Quem pode entrar pelo Google. Sem essa lista o login pelo Google é recusado.
GOOGLE_EMAILS_PERMITIDOS="voce@gmail.com"

# URL pública do CRM. Obrigatória em produção (Vercel) — usada para montar o
# redirect_uri do login com Google e qualquer link absoluto que o servidor
# precise gerar. Sem ela, em produção o sistema tentaria adivinhar pelo host
# da requisição, o que quebra atrás de proxy/CDN.
APP_URL="https://seu-app.vercel.app"

# Token para ferramentas externas (n8n, Make, Zapier, ou o worker embutido na
# bridge de WhatsApp) consumirem GET /api/externo/leads e pedirem o próximo
# envio em POST /api/externo/fila.
# Gere com: openssl rand -base64 24. Se ficar vazio, essas rotas recusam tudo.
# Precisa ser IGUAL ao PAINEL_TOKEN configurado na bridge (whatsapp-node).
API_TOKEN=""

# Autentica o WEBHOOK do provedor de WhatsApp (POST /api/automacao/status) —
# o evento de "o lead respondeu isto". Segredo PRÓPRIO, DIFERENTE do
# API_TOKEN: um autoriza ler leads e puxar a fila, o outro só avisar de uma
# resposta. Gere com: openssl rand -base64 24. Vazio recusa tudo.
# Precisa ser IGUAL ao WEBHOOK_SECRET configurado na bridge (whatsapp-node).
WEBHOOK_SECRET=""

# Cifra o token do provedor de WhatsApp em repouso (tabela `configuracoes`,
# campo `provedorToken` — o TOKEN_BRIDGE_API que a bridge exige em `/send`).
# Gere com: openssl rand -base64 32. Sem isso o token é salvo em texto puro.
SEGREDO_CHAVE=""
