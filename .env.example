# Neon Postgres (Vercel > Storage > Neon). Use a connection string "pooled".
DATABASE_URL="postgresql://user:senha@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Opcional: só se um dia quiser trocar o OpenStreetMap pelo Google (exige cartão)
GOOGLE_PLACES_API_KEY=""

# Grátis, sem cartão: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Senha única de acesso ao painel (só você usa). Deixe vazio se for entrar só
# pelo Google.
APP_PASSWORD=""

# Assina o cookie de sessão. Gere com: openssl rand -base64 32
# Se ficar vazio, o APP_PASSWORD é usado como segredo.
AUTH_SECRET=""

# Login com Google (opcional). Google Cloud > APIs e Serviços > Credenciais >
# ID do cliente OAuth > Aplicativo da Web. Em "URIs de redirecionamento
# autorizados" cadastre, uma linha para cada ambiente:
#   http://localhost:3000/api/auth/google/callback
#   https://SEU-APP.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Quem pode entrar pelo Google. Sem essa lista o login pelo Google é recusado.
GOOGLE_EMAILS_PERMITIDOS="voce@gmail.com"

# Só se o domínio público for diferente do host que chega no servidor.
# APP_URL="https://seu-app.vercel.app"

# Token para ferramentas externas (n8n, Make, Zapier) consumirem
# GET /api/externo/leads. Gere com: openssl rand -base64 24
# Se ficar vazio, a rota externa recusa TODAS as requisições.
API_TOKEN=""
