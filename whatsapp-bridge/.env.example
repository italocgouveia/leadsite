# API key that Leadsite uses when calling this bridge's /send endpoint.
BRIDGE_API_TOKEN=replace-with-a-long-random-secret

# Leadsite webhook URL. Add ?token=YOUR_WEBHOOK_SECRET to the URL.
WEBHOOK_URL=https://leads-eosin.vercel.app/api/automacao/status?token=replace-with-webhook-secret

# Local-only QR page. Never expose this port through Cloudflare Tunnel.
API_PORT=8081
PAIRING_PORT=8082
AUTH_DIR=./auth
