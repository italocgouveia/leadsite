# API key that Leadsite uses when calling this bridge's /send endpoint.
BRIDGE_API_TOKEN=replace-with-a-long-random-secret

# Leadsite webhook URL. Configure WEBHOOK_SECRET below as an Authorization Bearer header.
WEBHOOK_URL=https://leads-eosin.vercel.app/api/automacao/status
WEBHOOK_SECRET=replace-with-the-same-webhook-secret-configured-in-vercel

# Local-only QR page. Never expose this port through Cloudflare Tunnel.
API_PORT=8081
BIND_HOST=0.0.0.0
PAIRING_PORT=8082
AUTH_DIR=./auth
